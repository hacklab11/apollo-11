# Host port ranges allow independent --scale replicas without port collisions.
# No model credentials are needed for the wave smoke gate.
WEB_PORT=8080
SIM_PORT=8100
MCP_PORT=8110-8119
SPECIALISTS_PORT=8200-8209
SELLEROS_PORT=8300-8309

# Leave empty for the CI/startup smoke gate. Set your key for live Compose runs.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
EYE_MODEL_API_KEY=

# Keep stable across compatible Core deploys so pending workflows recover.
# Change only for incompatible workflow changes; drain old-version runs first.
EYE_DBOS_APPLICATION_VERSION=eye-orchestrator-v1

# Local-development OAuth credentials only. Replace each with a distinct secret
# (openssl rand -hex 32) for a shared deployment; never commit your .env.
EYE_AUTH_EYE_CORE_SECRET=dev-only-eye-core-replace-me
EYE_AUTH_SENTINEL_SECRET=dev-only-sentinel-replace-me
EYE_AUTH_DETECTIVE_SECRET=dev-only-detective-replace-me
EYE_AUTH_SKEPTIC_SECRET=dev-only-skeptic-replace-me
EYE_AUTH_REPORTER_SECRET=dev-only-reporter-replace-me
EYE_AUTH_CARTOGRAPHER_SECRET=dev-only-cartographer-replace-me
EYE_AUTH_GROWTH_SECRET=dev-only-growth-replace-me
EYE_AUTH_MARKETPLACE_SECRET=dev-only-marketplace-replace-me
EYE_AUTH_DISCOVERY_SECRET=dev-only-discovery-replace-me
EYE_AUTH_SELLEROS_SECRET=dev-only-selleros-replace-me
EYE_AUTH_SIM_SECRET=dev-only-sim-replace-me
