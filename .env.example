# Host port ranges allow independent --scale replicas without port collisions.
# No model credentials are needed for the wave smoke gate.
CORE_PORT=8000-8009
SIM_PORT=8100
MCP_PORT=8110-8119
SPECIALISTS_PORT=8200-8209
SELLEROS_PORT=8300-8309

# Leave empty for the CI/startup smoke gate. Set your key for live Compose runs.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
EYE_MODEL_API_KEY=
