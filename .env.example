# Host port ranges allow independent --scale replicas without port collisions.
# No model credentials are needed for the wave smoke gate.
WEB_PORT=8080
SIM_PORT=8100
MCP_PORT=8110-8119
SPECIALISTS_PORT=8200-8209
SELLEROS_PORT=8300-8309

# Leave empty for the CI/startup smoke gate. Set your key for live Compose runs.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
EYE_MODEL_API_KEY=

# Keep stable across compatible Core deploys so pending workflows recover.
# Change only for incompatible workflow changes; drain old-version runs first.
EYE_DBOS_APPLICATION_VERSION=eye-orchestrator-v1

# Shared by Core, SellerOS and sim; required for human-approved price reverts.
# Generate locally: openssl rand -hex 32
EYE_SELLER_REVERT_SERVICE_TOKEN=
